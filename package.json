{
  "name": "ska-billing",
  "version": "1.0.0",
  "description": "SK Aayurveda Billing App for Windows 7",
  "main": "main.js",
  "author": "KaiPo Keva Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win7": "electron-builder --win portable --ia32"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.keva.ska.billing",
    "productName": "SK Aayurveda Billing",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "dist-web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["ia32"]
        }
      ]
    }
  }
}
